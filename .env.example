# RH VISUALS API
PORT=8787

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=server/data/rh-visuals.sqlite

# Use a long random value in every environment.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
SESSION_HOURS=8

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Initial administrator. The account is created only when it does not exist.
ADMIN_NAME=Studio Owner
ADMIN_EMAIL=owner@rhvisuals.studio
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_ROLE=Owner

# Optional AI provider. Without a key the chatbot uses a transparent rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
